[
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure Azure Site Recovery for Azure resources",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must protect virtual machines that run in the West Europe region by using Azure Site Recovery, replicating them to North Europe. Where must the Recovery Services vault be created?",
 "domanda_it": "Devi proteggere macchine virtuali che girano nella region West Europe usando Azure Site Recovery, replicandole verso North Europe. Dove deve essere creato il Recovery Services vault?",
 "opzione_a": "In North Europe, the target region",
 "opzione_a_it": "In North Europe, la region di destinazione",
 "opzione_b": "In West Europe, the same region as the virtual machines",
 "opzione_b_it": "In West Europe, la stessa region delle macchine virtuali",
 "opzione_c": "In any region, provided it is in the same subscription as the virtual machines",
 "opzione_c_it": "In qualsiasi region, purché sia nella stessa subscription delle macchine virtuali",
 "opzione_d": "In the same resource group as the virtual machines, which fixes the region automatically",
 "opzione_d_it": "Nello stesso resource group delle macchine virtuali, che ne fissa automaticamente la region",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. For Azure-to-Azure replication the Recovery Services vault must be created in the target region, not with the machines it protects. The reason is a disaster-recovery one: if the source region becomes unavailable, a vault sitting in that same region would be unavailable too, and you could not orchestrate the failover. Why the others are wrong: (b) placing the vault beside the source machines is the intuitive answer and the classic trap - it defeats the purpose of the design. (c) the region is constrained, not free; the subscription is a separate matter. (d) a resource group has a location for its metadata only, and it neither constrains nor determines the region of resources placed in it.",
 "spiegazione_it": "Corretta: a. Per la replica da Azure ad Azure il Recovery Services vault deve essere creato nella region di destinazione, non insieme alle macchine che protegge. Il motivo è di continuità: se la region di origine diventa indisponibile, un vault che si trovasse nella stessa region sarebbe indisponibile a sua volta e non potresti orchestrare il failover. Perché le altre sono sbagliate: (b) mettere il vault accanto alle macchine di origine è la risposta istintiva e la trappola classica: vanifica lo scopo stesso dell'impianto. (c) la region è vincolata, non libera; la subscription è una questione a parte. (d) un resource group ha una location solo per i propri metadati, e non vincola né determina la region delle risorse che ci metti dentro.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-tutorial-enable-replication",
 "tags": "site recovery, recovery services vault, region, disaster recovery"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure Azure Site Recovery for Azure resources",
 "tipo": "hotspot",
 "difficolta": 3,
 "domanda": "You are configuring a replication policy for Azure-to-Azure Site Recovery. Select the appropriate option for each statement.",
 "domanda_it": "Stai configurando una replication policy per Azure Site Recovery da Azure ad Azure. Seleziona l'opzione appropriata per ogni affermazione.",
 "opzione_a": "Type of recovery point that Site Recovery generates continuously: [Crash-consistent | Application-consistent | Incremental-only]",
 "opzione_a_it": "Tipo di recovery point che Site Recovery genera in continuazione: [Crash-consistent | Application-consistent | Solo incrementale]",
 "opzione_b": "Storage resource created in the source region to hold changes before replication: [A cache storage account | A Recovery Services vault | A managed disk snapshot]",
 "opzione_b_it": "Risorsa di storage creata nella region di origine per trattenere le modifiche prima della replica: [Un cache storage account | Un Recovery Services vault | Uno snapshot di managed disk]",
 "opzione_c": "Effect of increasing the recovery point retention period: [More recovery points are kept, and storage cost rises | Replication becomes more frequent | The RPO improves]",
 "opzione_c_it": "Effetto dell'aumento del periodo di conservazione dei recovery point: [Vengono conservati più recovery point e il costo di storage sale | La replica diventa più frequente | L'RPO migliora]",
 "opzione_d": "",
 "opzione_d_it": "",
 "opzione_e": "",
 "opzione_e_it": "",
 "risposta_corretta": "Crash-consistent,A cache storage account,More recovery points are kept, and storage cost rises",
 "spiegazione": "Dropdown 1 - 'Crash-consistent': Site Recovery generates crash-consistent recovery points continuously, and generates application-consistent points only at the separate, less frequent interval configured in the policy, because they require quiescing the application. 'Incremental-only' is not a recovery point type. Dropdown 2 - 'A cache storage account': changes on the source disks are written first to a cache storage account in the source region, and replication reads from there, which keeps the write path off the critical replication path. The vault orchestrates but stores no replica data, and a managed disk snapshot is a point-in-time copy, not a staging area. Dropdown 3 - 'More recovery points are kept, and storage cost rises': retention determines how far back you can recover and therefore how much recovery point data is stored. It does not change replication frequency, and it does not improve RPO - RPO is governed by how quickly changes replicate, not by how long old points are kept.",
 "spiegazione_it": "Menu 1 corretto: 'Crash-consistent'. Site Recovery genera recovery point crash-consistent in continuazione, e ne genera di application-consistent solo all'intervallo separato e meno frequente configurato nella policy, perché richiedono di quiescere l'applicazione. 'Solo incrementale' non è un tipo di recovery point. Menu 2 corretto: 'Un cache storage account'. Le modifiche sui dischi di origine vengono scritte prima in un cache storage account nella region di origine, e la replica legge da lì: così il percorso di scrittura resta fuori dal percorso critico della replica. Il vault orchestra ma non conserva dati replicati, e uno snapshot di managed disk è una copia puntuale, non un'area di transito. Menu 3 corretto: 'Vengono conservati più recovery point e il costo di storage sale'. La retention determina quanto indietro puoi tornare e quindi quanti dati di recovery point vengono archiviati. Non cambia la frequenza della replica e non migliora l'RPO: l'RPO dipende da quanto in fretta le modifiche vengono replicate, non da quanto a lungo si conservano i punti vecchi.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-how-to-enable-replication",
 "tags": "site recovery, replication policy, recovery point, cache storage account"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure Azure Site Recovery for Azure resources",
 "tipo": "multiple_response",
 "difficolta": 2,
 "domanda": "When you enable Azure-to-Azure replication for a virtual machine, Site Recovery creates resources in the target region on your behalf if you do not select existing ones. Which resources are created in the target region? Each correct answer presents part of the solution. Select all that apply.",
 "domanda_it": "Quando abiliti la replica da Azure ad Azure per una macchina virtuale, Site Recovery crea per tuo conto delle risorse nella region di destinazione, se non ne selezioni di esistenti. Quali risorse vengono create nella region di destinazione? Ogni risposta corretta rappresenta una parte della soluzione. Selezionale tutte.",
 "opzione_a": "A target resource group",
 "opzione_a_it": "Un resource group di destinazione",
 "opzione_b": "A target virtual network",
 "opzione_b_it": "Una virtual network di destinazione",
 "opzione_c": "A replica managed disk for each source disk",
 "opzione_c_it": "Un managed disk replica per ogni disco di origine",
 "opzione_d": "A running virtual machine that mirrors the source",
 "opzione_d_it": "Una macchina virtuale in esecuzione che rispecchia quella di origine",
 "opzione_e": "A public IP address reserved for failover",
 "opzione_e_it": "Un indirizzo IP pubblico riservato per il failover",
 "risposta_corretta": "a,b,c",
 "spiegazione": "Correct: a, b and c. When replication is enabled, Site Recovery provisions the target resource group, a target virtual network mapped to the source network, and replica managed disks that receive the replicated data. Why the others are wrong: (d) no virtual machine runs in the target region until a failover occurs - that is the entire cost model of Site Recovery: you pay for replicated storage, not for idle duplicate compute. (e) a public IP address is not reserved in advance; if the failed-over machine needs one, you assign it as part of the failover or afterwards.",
 "spiegazione_it": "Corrette: a, b e c. All'abilitazione della replica, Site Recovery crea il resource group di destinazione, una virtual network di destinazione mappata su quella di origine e i managed disk replica che ricevono i dati replicati. Perché le altre sono sbagliate: (d) nessuna macchina virtuale gira nella region di destinazione finché non avviene un failover: è tutto il modello di costo di Site Recovery, paghi lo storage replicato, non capacità di calcolo duplicata e inattiva. (e) un indirizzo IP pubblico non viene riservato in anticipo; se la macchina sottoposta a failover ne ha bisogno, lo assegni durante il failover o subito dopo.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-tutorial-enable-replication",
 "tags": "site recovery, replica disk, target region, costo"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Perform a failover to a secondary region by using Site Recovery",
 "tipo": "drag_drop",
 "difficolta": 3,
 "domanda": "A region-wide outage has taken down the virtual machines protected by Azure Site Recovery. You must fail the workload over to the secondary region and then return it to the original region once that region is healthy again. Which four actions should you perform in sequence? Move the appropriate actions from the list to the answer area and arrange them in the correct order.",
 "domanda_it": "Un'interruzione che ha colpito un'intera region ha messo fuori uso le macchine virtuali protette da Azure Site Recovery. Devi eseguire il failover del carico verso la region secondaria e poi riportarlo nella region originale quando questa torna sana. Quali quattro azioni dovresti eseguire in sequenza? Sposta le azioni appropriate dall'elenco all'area di risposta e disponile nell'ordine corretto.",
 "opzione_a": "Run an unplanned failover to the secondary region.",
 "opzione_a_it": "Eseguire un failover non pianificato verso la region secondaria.",
 "opzione_b": "Commit the failover to discard the other recovery points.",
 "opzione_b_it": "Eseguire il commit del failover per scartare gli altri recovery point.",
 "opzione_c": "Reprotect the virtual machines so that they replicate from the secondary region back to the original one.",
 "opzione_c_it": "Eseguire il reprotect delle macchine virtuali perché replichino dalla region secondaria verso quella originale.",
 "opzione_d": "Run a failover from the secondary region back to the original region.",
 "opzione_d_it": "Eseguire un failover dalla region secondaria verso la region originale.",
 "opzione_e": "Run a test failover into an isolated virtual network.",
 "opzione_e_it": "Eseguire un test failover in una virtual network isolata.",
 "risposta_corretta": "a,b,c,d",
 "spiegazione": "Correct order: a, b, c, d. The outage has already happened, so the first step is an unplanned failover, which does not require the source to be reachable. The failed-over machine then sits in a pending state offering a choice of recovery points, and committing the failover accepts the one in use and discards the rest. Only after the commit can you reprotect, which reverses the replication direction so changes now flow from the secondary region back to the original. Failing back is then simply a failover in the opposite direction. Why option e is not used: a test failover validates the plan without touching production and is something you do in advance, on a healthy system. During a real outage it neither restores service nor advances the failback sequence.",
 "spiegazione_it": "Ordine corretto: a, b, c, d. L'interruzione è già avvenuta, quindi il primo passaggio è un failover non pianificato, che non richiede che l'origine sia raggiungibile. La macchina sottoposta a failover resta poi in uno stato pendente che offre una scelta di recovery point, e il commit del failover accetta quello in uso e scarta gli altri. Solo dopo il commit puoi eseguire il reprotect, che inverte la direzione della replica: da quel momento le modifiche fluiscono dalla region secondaria verso quella originale. Il failback è a quel punto semplicemente un failover nella direzione opposta. Perché l'opzione e non viene usata: un test failover valida il piano senza toccare la produzione ed è qualcosa che si fa in anticipo, a sistema sano. Durante un'interruzione reale non ripristina il servizio né fa avanzare la sequenza di failback.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-tutorial-failover-failback",
 "tags": "site recovery, failover, commit, reprotect, failback"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Perform a failover to a secondary region by using Site Recovery",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "You must verify quarterly that your Site Recovery configuration works, without interrupting the production workload and without any data loss. What should you do?",
 "domanda_it": "Devi verificare ogni trimestre che la configurazione di Site Recovery funzioni, senza interrompere il carico di produzione e senza perdita di dati. Cosa dovresti fare?",
 "opzione_a": "Run a test failover into a virtual network that is isolated from the production network",
 "opzione_a_it": "Eseguire un test failover in una virtual network isolata da quella di produzione",
 "opzione_b": "Run a planned failover, then immediately fail back",
 "opzione_b_it": "Eseguire un failover pianificato e subito dopo il failback",
 "opzione_c": "Run an unplanned failover and choose the latest application-consistent recovery point",
 "opzione_c_it": "Eseguire un failover non pianificato scegliendo l'ultimo recovery point application-consistent",
 "opzione_d": "Disable and re-enable replication for the protected virtual machines",
 "opzione_d_it": "Disabilitare e riabilitare la replica per le macchine virtuali protette",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. A test failover is designed exactly for this: it brings up a copy of the protected machines without affecting production replication and without any downtime, and Learn recommends running it into a separate, isolated network so the test machines cannot collide with production addresses or services. When you are done you clean up the test failover and nothing is left behind. Why the others are wrong: (b) a planned failover shuts down the source machines to guarantee no data loss, so it does interrupt production. (c) an unplanned failover is the real thing - it moves the workload and stops replication, which is precisely what a drill must avoid. (d) disabling replication removes the protection and forces a full initial replication when re-enabled, which tests nothing and leaves you exposed in the meantime.",
 "spiegazione_it": "Corretta: a. Il test failover è pensato esattamente per questo: accende una copia delle macchine protette senza toccare la replica di produzione e senza alcun fermo, e Learn raccomanda di eseguirlo in una rete separata e isolata, così le macchine di test non possono collidere con indirizzi o servizi di produzione. A fine prova si esegue la pulizia del test failover e non resta nulla. Perché le altre sono sbagliate: (b) un failover pianificato spegne le macchine di origine per garantire zero perdita di dati, quindi la produzione la interrompe eccome. (c) un failover non pianificato è la cosa vera: sposta il carico e ferma la replica, ossia proprio ciò che un'esercitazione deve evitare. (d) disabilitare la replica rimuove la protezione e impone una replica iniziale completa alla riattivazione: non verifica nulla e nel frattempo ti lascia scoperto.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/site-recovery/azure-to-azure-tutorial-dr-drill",
 "tags": "site recovery, test failover, dr drill, rete isolata"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Create an Azure Backup vault",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must configure backup for Azure Blob Storage, Azure Disks and an Azure Database for PostgreSQL flexible server. Which vault type should you create?",
 "domanda_it": "Devi configurare il backup per Azure Blob Storage, Azure Disks e un server flessibile Azure Database for PostgreSQL. Quale tipo di vault dovresti creare?",
 "opzione_a": "A Backup vault",
 "opzione_a_it": "Un Backup vault",
 "opzione_b": "A Recovery Services vault",
 "opzione_b_it": "Un Recovery Services vault",
 "opzione_c": "An Azure Key Vault with the backup access policy enabled",
 "opzione_c_it": "Un Azure Key Vault con la policy di accesso backup abilitata",
 "opzione_d": "A storage account with immutability enabled",
 "opzione_d_it": "Uno storage account con immutabilità abilitata",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Azure Backup uses two different vault resources, and the datasource decides which one. The Backup vault is the newer of the two and is the one that supports Azure Disks, Azure Blobs, Azure Database for PostgreSQL and Kubernetes. Why the others are wrong: (b) a Recovery Services vault covers the older estate - Azure VMs, Azure Files, SQL Server in an Azure VM, SAP HANA, and on-premises workloads through the MARS agent - and it cannot protect the three datasources listed. (c) Azure Key Vault stores secrets, keys and certificates; it is not a backup destination. (d) a storage account with immutability protects blobs from deletion but is not a backup vault and provides none of the policy, retention or restore tooling.",
 "spiegazione_it": "Corretta: a. Azure Backup usa due risorse vault diverse, ed è la sorgente dati a decidere quale. Il Backup vault è il più recente dei due ed è quello che supporta Azure Disks, Azure Blobs, Azure Database for PostgreSQL e Kubernetes. Perché le altre sono sbagliate: (b) un Recovery Services vault copre il parco più vecchio - macchine virtuali Azure, Azure Files, SQL Server dentro una VM Azure, SAP HANA e i carichi on-premises tramite l'agente MARS - e non può proteggere le tre sorgenti elencate. (c) Azure Key Vault archivia segreti, chiavi e certificati: non è una destinazione di backup. (d) uno storage account con immutabilità protegge i blob dall'eliminazione, ma non è un vault di backup e non offre nessuno degli strumenti di policy, conservazione e ripristino.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/backup/backup-vault-overview",
 "tags": "backup vault, recovery services vault, blob backup, disk backup"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Create an Azure Backup vault",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "You create a Backup vault and accept the default storage redundancy. Before configuring any backup, you decide the vault must use zone-redundant storage instead. What should you do?",
 "domanda_it": "Crei un Backup vault accettando la ridondanza di storage predefinita. Prima di configurare qualsiasi backup, decidi che il vault deve usare storage con ridondanza della zona. Cosa dovresti fare?",
 "opzione_a": "Change the storage redundancy on the vault, because no backup has been configured yet",
 "opzione_a_it": "Cambiare la ridondanza di storage sul vault, dato che non è ancora stato configurato alcun backup",
 "opzione_b": "Delete the vault and create a new one, because redundancy is fixed at creation",
 "opzione_b_it": "Eliminare il vault e crearne uno nuovo, perché la ridondanza è fissata alla creazione",
 "opzione_c": "Change the redundancy of the storage account that backs the vault",
 "opzione_c_it": "Cambiare la ridondanza dello storage account che sta dietro al vault",
 "opzione_d": "Enable cross-region restore, which converts the vault to zone-redundant storage",
 "opzione_d_it": "Abilitare il cross-region restore, che converte il vault a storage con ridondanza della zona",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Storage redundancy on a vault can be changed only before the first backup is protected in it. Since no backup has been configured, the setting is still editable and you can switch it to zone-redundant. Why the others are wrong: (b) deleting and recreating is the correct answer only after a backup item exists, and the question is careful to say none does - this is the distinction being tested. (c) the storage behind a vault is managed by the service and is not exposed as a storage account you can reconfigure. (d) cross-region restore is a separate capability that relies on geo-redundant storage; it does not set or convert redundancy to zone-redundant.",
 "spiegazione_it": "Corretta: a. La ridondanza di storage di un vault si può cambiare soltanto prima che vi venga protetto il primo backup. Poiché nessun backup è ancora stato configurato, l'impostazione è ancora modificabile e puoi passare alla ridondanza della zona. Perché le altre sono sbagliate: (b) eliminare e ricreare è la risposta corretta solo dopo che esiste un elemento di backup, e la domanda precisa che non ne esiste nessuno: è proprio questa la distinzione messa alla prova. (c) lo storage dietro a un vault è gestito dal servizio e non viene esposto come uno storage account riconfigurabile. (d) il cross-region restore è una capacità distinta che si appoggia allo storage geo-ridondante: non imposta né converte la ridondanza a zone-redundant.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/backup/backup-vault-overview",
 "tags": "backup vault, ridondanza, zrs, cross-region restore"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure and interpret reports and alerts for backups",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must produce a report that shows backup job success rates and storage consumption across every Recovery Services vault in your subscription, with 90 days of history. What should you configure first?",
 "domanda_it": "Devi produrre un report che mostri i tassi di successo dei job di backup e il consumo di storage per ogni Recovery Services vault della subscription, con 90 giorni di storico. Cosa dovresti configurare per primo?",
 "opzione_a": "A diagnostic setting on each vault that sends the backup data to a Log Analytics workspace",
 "opzione_a_it": "Un diagnostic setting su ogni vault che invia i dati di backup a un workspace di Log Analytics",
 "opzione_b": "A metric alert rule on each vault with a 90-day aggregation window",
 "opzione_b_it": "Una regola di avviso su metrica per ogni vault con una finestra di aggregazione di 90 giorni",
 "opzione_c": "An Azure Monitor workbook scoped to the subscription",
 "opzione_c_it": "Un workbook di Azure Monitor con ambito la subscription",
 "opzione_d": "Soft delete with an extended retention period on each vault",
 "opzione_d_it": "Il soft delete con periodo di conservazione esteso su ogni vault",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Backup Reports are built on Log Analytics: each vault needs a diagnostic setting that pushes its backup data to a workspace, and only then can the report query history across vaults. Without that plumbing the report is empty, and the vault itself keeps only limited recent job data. Why the others are wrong: (b) a metric alert fires on a threshold; it does not accumulate reportable history, and Azure Monitor metrics are retained for 93 days but are not the source Backup Reports uses. (c) a workbook is a presentation layer and is in fact how the report is rendered, but it has nothing to show until the diagnostic data is flowing - which is why the question asks what comes first. (d) soft delete protects deleted backup data from being purged; it produces no reporting at all.",
 "spiegazione_it": "Corretta: a. I Backup Report si appoggiano a Log Analytics: ogni vault ha bisogno di un diagnostic setting che spinga i suoi dati di backup verso un workspace, e solo allora il report può interrogare lo storico fra più vault. Senza quel collegamento il report resta vuoto, e il vault da solo conserva soltanto dati recenti e limitati sui job. Perché le altre sono sbagliate: (b) un avviso su metrica scatta al superamento di una soglia, non accumula storico consultabile, e le metriche di Azure Monitor si conservano per 93 giorni ma non sono la sorgente usata dai Backup Report. (c) un workbook è uno strato di presentazione ed è di fatto il modo in cui il report viene disegnato, ma non ha nulla da mostrare finché i dati diagnostici non fluiscono: per questo la domanda chiede cosa venga prima. (d) il soft delete protegge dalla cancellazione definitiva i dati di backup eliminati, ma non produce alcuna reportistica.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/backup/configure-reports",
 "tags": "backup report, log analytics, diagnostic setting"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure and interpret reports and alerts for backups",
 "tipo": "yes_no_series",
 "difficolta": 3,
 "domanda": "You are reviewing how alerting works for Azure Backup. For each statement, select Yes if the statement is true. Otherwise, select No.",
 "domanda_it": "Stai esaminando il funzionamento degli avvisi per Azure Backup. Per ogni affermazione scegli Sì se è vera, altrimenti No.",
 "opzione_a": "Built-in Azure Monitor alerts for Azure Backup are raised for backup failures without you creating an alert rule.",
 "opzione_a_it": "Gli avvisi integrati di Azure Monitor per Azure Backup vengono generati in caso di backup fallito senza che tu crei una regola di avviso.",
 "opzione_b": "To have a built-in backup alert send email, you must attach an alert processing rule with an action group.",
 "opzione_b_it": "Perché un avviso di backup integrato invii una email, devi collegare una alert processing rule con un action group.",
 "opzione_c": "Backup Reports refresh in near real time, within a few minutes of a backup job completing.",
 "opzione_c_it": "I Backup Report si aggiornano quasi in tempo reale, entro pochi minuti dal completamento di un job di backup.",
 "risposta_corretta": "yes,yes,no",
 "spiegazione": "Statement 1 - Yes. Azure Backup raises built-in Azure Monitor alerts for events such as backup failure automatically; the detection side needs no rule from you. Statement 2 - Yes. Detection and notification are separate concerns: the built-in alert is generated, but nothing is sent anywhere until an alert processing rule routes it to an action group that defines the email, SMS or webhook target. This split is the part people miss, and it is why an administrator can see alerts in the portal while nobody receives a message. Statement 3 - No. Backup Reports are fed by Log Analytics and the data flows on a scheduled push, so the reports lag by hours rather than minutes. They are a reporting tool for trends, not a live console - if you need immediate notice of a failed job you use the alert, not the report.",
 "spiegazione_it": "L'affermazione 1 è Sì. Azure Backup genera automaticamente avvisi integrati di Azure Monitor per eventi come il fallimento di un backup: dal lato rilevamento non serve alcuna regola da parte tua. L'affermazione 2 è Sì. Rilevamento e notifica sono due cose distinte: l'avviso integrato viene generato, ma non parte nulla verso nessuno finché una alert processing rule non lo instrada verso un action group che definisce la destinazione email, SMS o webhook. È la separazione che sfugge più spesso, ed è il motivo per cui un amministratore può vedere gli avvisi nel portale mentre nessuno riceve un messaggio. L'affermazione 3 è No. I Backup Report sono alimentati da Log Analytics e i dati arrivano con una spinta pianificata, quindi i report sono indietro di ore, non di minuti. Sono uno strumento di reportistica per le tendenze, non una console dal vivo: se ti serve avviso immediato di un job fallito usi l'avviso, non il report.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/backup/backup-azure-monitoring-built-in-monitor",
 "tags": "backup, alert, action group, alert processing rule, report"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure and interpret monitoring of virtual machines, storage accounts, and networks by using Azure Monitor Insights",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must see which processes on a virtual machine are talking to which remote hosts, drawn as a live dependency map, without installing anything manually on the guest. What should you enable?",
 "domanda_it": "Devi vedere quali processi di una macchina virtuale comunicano con quali host remoti, disegnati come una mappa delle dipendenze dal vivo, senza installare nulla manualmente nel sistema guest. Cosa dovresti abilitare?",
 "opzione_a": "VM insights with processes and dependencies enabled",
 "opzione_a_it": "VM insights con processi e dipendenze abilitati",
 "opzione_b": "Network Watcher packet capture on the virtual machine",
 "opzione_b_it": "La packet capture di Network Watcher sulla macchina virtuale",
 "opzione_c": "Boot diagnostics with serial console access",
 "opzione_c_it": "I boot diagnostics con accesso alla console seriale",
 "opzione_d": "A diagnostic setting that sends platform metrics to a Log Analytics workspace",
 "opzione_d_it": "Un diagnostic setting che invia le metriche di piattaforma a un workspace di Log Analytics",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. VM insights is the Azure Monitor Insight for virtual machines, and its Map feature is exactly this: it discovers running processes and the TCP connections between them, and renders them as a dependency map. Enabling it deploys the Azure Monitor Agent and the Dependency agent for you, so nothing is installed by hand. Why the others are wrong: (b) packet capture records raw traffic for offline analysis in a tool such as Wireshark; it produces no map and no process attribution. (c) boot diagnostics shows console output for a machine that will not start - a completely different problem. (d) platform metrics describe the virtual machine as seen from the host, such as CPU and disk throughput; they contain no information about processes or connections inside the guest.",
 "spiegazione_it": "Corretta: a. VM insights è l'Insight di Azure Monitor per le macchine virtuali, e la sua funzionalità Map è esattamente questa: rileva i processi in esecuzione e le connessioni TCP fra di essi, e li disegna come mappa delle dipendenze. Abilitarla distribuisce per te l'Azure Monitor Agent e il Dependency agent, quindi non installi nulla a mano. Perché le altre sono sbagliate: (b) la packet capture registra il traffico grezzo per un'analisi offline con strumenti come Wireshark: non produce mappe né attribuzione ai processi. (c) i boot diagnostics mostrano l'output della console di una macchina che non parte, che è un problema del tutto diverso. (d) le metriche di piattaforma descrivono la macchina virtuale vista dall'host, come CPU e throughput dei dischi: non contengono alcuna informazione su processi o connessioni dentro il sistema guest.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-monitor/vm/vminsights-overview",
 "tags": "vm insights, dependency map, azure monitor agent"
},
{
 "batch_id": "MON-G",
 "dominio": "Monitor and maintain Azure resources",
 "sotto_argomento": "Configure and interpret monitoring of virtual machines, storage accounts, and networks by using Azure Monitor Insights",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "Storage insights for a storage account shows a rising Success E2E Latency while Success Server Latency stays flat. What does this pattern most likely indicate?",
 "domanda_it": "Storage insights per uno storage account mostra una Success E2E Latency in crescita mentre la Success Server Latency resta piatta. Cosa indica più probabilmente questo andamento?",
 "opzione_a": "The delay is on the client side or in the network, not in the storage service",
 "opzione_a_it": "Il ritardo è lato client o nella rete, non nel servizio di storage",
 "opzione_b": "The storage account is being throttled and is returning 503 responses",
 "opzione_b_it": "Lo storage account è sottoposto a throttling e restituisce risposte 503",
 "opzione_c": "The account has exceeded its capacity limit",
 "opzione_c_it": "L'account ha superato il proprio limite di capacità",
 "opzione_d": "Geo-replication to the secondary region is lagging",
 "opzione_d_it": "La geo-replica verso la region secondaria è in ritardo",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Success Server Latency measures only the time Azure Storage spends processing the request, while Success E2E Latency measures the whole round trip, including network transit and the time the client takes to send and receive data. When end-to-end latency climbs and server latency does not, the storage service is doing its job at the same speed as before and the added delay is outside it - a slow client, a congested link, or a chatty pattern of small requests. Why the others are wrong: (b) throttling shows up as failed or throttled transactions and typically raises server-side latency too. (c) capacity is reported by separate capacity metrics and does not manifest as a latency split. (d) geo-replication lag has its own metric and does not affect the latency of primary-region requests.",
 "spiegazione_it": "Corretta: a. La Success Server Latency misura solo il tempo che Azure Storage impiega a elaborare la richiesta, mentre la Success E2E Latency misura l'intero giro, inclusi il transito di rete e il tempo che il client impiega a inviare e ricevere i dati. Quando la latenza end-to-end sale e quella server no, il servizio di storage sta lavorando alla stessa velocità di prima e il ritardo aggiunto è fuori da esso: un client lento, un collegamento congestionato, o uno schema fatto di tante richieste piccole. Perché le altre sono sbagliate: (b) il throttling si manifesta come transazioni fallite o limitate e di norma alza anche la latenza lato server. (c) la capacità viene riportata da metriche di capacità separate e non si manifesta come divaricazione fra le due latenze. (d) il ritardo della geo-replica ha una metrica propria e non incide sulla latenza delle richieste alla region primaria.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/storage/common/storage-insights-overview",
 "tags": "storage insights, latency, e2e latency, server latency"
}
]
