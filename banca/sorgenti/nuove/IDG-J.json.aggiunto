[
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage subscriptions",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "Contoso acquires Fabrikam and must move the Fabrikam Azure subscription into the Contoso Microsoft Entra tenant. What happens to the Azure role assignments that exist in the subscription after the transfer?",
 "domanda_it": "Contoso acquisisce Fabrikam e deve spostare la subscription Azure di Fabrikam nel tenant Microsoft Entra di Contoso. Cosa succede alle assegnazioni di ruolo Azure presenti nella subscription dopo il trasferimento?",
 "opzione_a": "All Azure role assignments are permanently removed and must be recreated for principals in the new tenant",
 "opzione_a_it": "Tutte le assegnazioni di ruolo Azure vengono rimosse definitivamente e vanno ricreate per i principal del nuovo tenant",
 "opzione_b": "The role assignments are preserved and automatically remapped to matching users in the new tenant",
 "opzione_b_it": "Le assegnazioni di ruolo vengono conservate e rimappate automaticamente sugli utenti corrispondenti nel nuovo tenant",
 "opzione_c": "Only role assignments at subscription scope are removed; assignments on resource groups and resources are preserved",
 "opzione_c_it": "Vengono rimosse solo le assegnazioni con ambito subscription; quelle su resource group e risorse vengono conservate",
 "opzione_d": "The role assignments remain but become read-only until an owner reactivates them",
 "opzione_d_it": "Le assegnazioni di ruolo restano ma diventano di sola lettura finché un owner non le riattiva",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Azure role assignments point at security principals that live in a specific Microsoft Entra directory. When a subscription is transferred to another directory, those principals no longer resolve, so every Azure role assignment in the subscription is removed - at every scope - and access must be granted again to principals in the destination tenant. Learn is explicit that the assignments do not transfer. Why the others are wrong: (b) there is no automatic remapping; two directories may contain accounts with the same display name or even the same UPN, but they are different objects with different IDs. (c) the removal is not limited to subscription scope; assignments on resource groups and individual resources go too. (d) no such read-only state exists - the assignments are gone, not suspended.",
 "spiegazione_it": "Corretta: a. Le assegnazioni di ruolo Azure puntano a security principal che vivono in una directory Microsoft Entra specifica. Quando una subscription viene trasferita in un'altra directory quei principal non si risolvono più, quindi ogni assegnazione di ruolo Azure della subscription viene rimossa, a qualsiasi ambito, e l'accesso va concesso di nuovo a principal del tenant di destinazione. Learn dice esplicitamente che le assegnazioni non vengono trasferite. Perché le altre sono sbagliate: (b) non esiste alcuna rimappatura automatica; due directory possono contenere account con lo stesso nome visualizzato o perfino lo stesso UPN, ma sono oggetti diversi con ID diversi. (c) la rimozione non si limita all'ambito subscription: se ne vanno anche le assegnazioni su resource group e singole risorse. (d) non esiste alcuno stato di sola lettura del genere: le assegnazioni spariscono, non vengono sospese.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/role-based-access-control/transfer-subscription",
 "tags": "subscription, trasferimento directory, rbac, tenant"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage subscriptions",
 "tipo": "yes_no_series",
 "difficolta": 2,
 "domanda": "You are reviewing how Azure subscriptions relate to other objects. For each statement, select Yes if the statement is true. Otherwise, select No.",
 "domanda_it": "Stai esaminando il rapporto fra le subscription Azure e gli altri oggetti. Per ogni affermazione scegli Sì se è vera, altrimenti No.",
 "opzione_a": "A subscription is associated with exactly one Microsoft Entra directory at a time.",
 "opzione_a_it": "Una subscription è associata a una sola directory Microsoft Entra alla volta.",
 "opzione_b": "A single Microsoft Entra directory can trust many subscriptions.",
 "opzione_b_it": "Una singola directory Microsoft Entra può fare da riferimento a molte subscription.",
 "opzione_c": "Cancelling a subscription deletes its resources immediately and irreversibly.",
 "opzione_c_it": "Annullare una subscription elimina le sue risorse immediatamente e in modo irreversibile.",
 "risposta_corretta": "yes,yes,no",
 "spiegazione": "Statement 1 - Yes. Each subscription trusts exactly one directory for authentication; that is why moving it to another directory is a deliberate transfer operation rather than an additive one. Statement 2 - Yes. The relationship is one directory to many subscriptions, which is how an organization keeps a single identity boundary across separate billing and isolation units. Statement 3 - No. After cancellation the subscription is disabled and its resources are retained for a grace period - Microsoft documents 30 to 90 days depending on the agreement - during which the subscription can be reactivated. Permanent deletion happens only after that window, which is what makes an accidental cancellation recoverable.",
 "spiegazione_it": "L'affermazione 1 è Sì. Ogni subscription si affida a una sola directory per l'autenticazione: è il motivo per cui spostarla in un'altra directory è un'operazione di trasferimento deliberata e non un'aggiunta. L'affermazione 2 è Sì. Il rapporto è di una directory verso molte subscription, ed è così che un'organizzazione mantiene un unico confine di identità su unità di fatturazione e isolamento separate. L'affermazione 3 è No. Dopo l'annullamento la subscription viene disabilitata e le sue risorse vengono conservate per un periodo di tolleranza - Microsoft documenta da 30 a 90 giorni a seconda del contratto - durante il quale la subscription può essere riattivata. L'eliminazione definitiva avviene solo dopo quella finestra, ed è ciò che rende recuperabile un annullamento accidentale.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/cost-management-billing/manage/cancel-azure-subscription",
 "tags": "subscription, directory, annullamento, grace period"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage subscriptions",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "A subscription has reached the maximum number of resource groups allowed. You must confirm the current usage against the limit for that subscription in the West Europe region. Which portal blade should you open?",
 "domanda_it": "Una subscription ha raggiunto il numero massimo di resource group consentito. Devi verificare l'utilizzo corrente rispetto al limite per quella subscription nella region West Europe. Quale pannello del portale dovresti aprire?",
 "opzione_a": "Usage + quotas on the subscription",
 "opzione_a_it": "Usage + quotas sulla subscription",
 "opzione_b": "Cost analysis on the subscription",
 "opzione_b_it": "Cost analysis sulla subscription",
 "opzione_c": "Resource providers on the subscription",
 "opzione_c_it": "Resource providers sulla subscription",
 "opzione_d": "Access control (IAM) on the subscription",
 "opzione_d_it": "Access control (IAM) sulla subscription",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Usage + quotas is the blade that lists current consumption against the subscription limits, filtered by provider, location and quota type, and it is where you request an increase when a limit is adjustable. Why the others are wrong: (b) Cost analysis reports money spent, not how many objects exist against a quota - a subscription can be far under budget and still be at a hard limit. (c) Resource providers shows which providers are registered for the subscription, which determines what resource types you may create, not how many. (d) Access control (IAM) manages role assignments and says nothing about capacity.",
 "spiegazione_it": "Corretta: a. Usage + quotas è il pannello che elenca il consumo corrente rispetto ai limiti della subscription, filtrabile per provider, location e tipo di quota, ed è il punto da cui si richiede un aumento quando un limite è modificabile. Perché le altre sono sbagliate: (b) Cost analysis riporta il denaro speso, non quanti oggetti esistono rispetto a una quota: una subscription può essere ampiamente sotto budget e ciononostante avere raggiunto un limite rigido. (c) Resource providers mostra quali provider sono registrati per la subscription, il che determina quali tipi di risorsa puoi creare, non quanti. (d) Access control (IAM) gestisce le assegnazioni di ruolo e non dice nulla sulla capacità.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/azure-subscription-service-limits",
 "tags": "subscription, quota, limiti, usage + quotas"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage user and group properties",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You attempt to assign a Microsoft 365 license to a newly created Microsoft Entra user and the assignment fails. Which user property is most likely missing?",
 "domanda_it": "Provi ad assegnare una licenza Microsoft 365 a un utente Microsoft Entra appena creato e l'assegnazione fallisce. Quale proprietà dell'utente manca più probabilmente?",
 "opzione_a": "Usage location",
 "opzione_a_it": "Usage location",
 "opzione_b": "Job title",
 "opzione_b_it": "Job title",
 "opzione_c": "Manager",
 "opzione_c_it": "Manager",
 "opzione_d": "Employee ID",
 "opzione_d_it": "Employee ID",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Some Microsoft services are not available in every country or region, so Microsoft Entra ID requires the usage location property to be set before a license can be assigned. Without it the assignment fails, and this is the single most common cause of the error. Why the others are wrong: (b), (c) and (d) job title, manager and employee ID are descriptive attributes. They are useful for dynamic group rules and for the organizational hierarchy, but none of them is required for licensing, and leaving them blank never blocks an assignment.",
 "spiegazione_it": "Corretta: a. Alcuni servizi Microsoft non sono disponibili in ogni paese o region, quindi Microsoft Entra ID richiede che la proprietà usage location sia impostata prima di poter assegnare una licenza. Senza di essa l'assegnazione fallisce, ed è di gran lunga la causa più frequente dell'errore. Perché le altre sono sbagliate: (b), (c) e (d) job title, manager ed employee ID sono attributi descrittivi. Sono utili per le regole dei gruppi dinamici e per la gerarchia organizzativa, ma nessuno di essi è necessario per le licenze, e lasciarli vuoti non blocca mai un'assegnazione.",
 "url_riferimento": "https://learn.microsoft.com/en-us/entra/identity/users/licensing-groups-assign",
 "tags": "usage location, licenza, proprietà utente"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage built-in Azure roles",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "A user is assigned the Storage Account Contributor role on a storage account. The user reports that they can see the account in the portal and change its configuration, but cannot read the contents of a blob container. Why?",
 "domanda_it": "A un utente è assegnato il ruolo Storage Account Contributor su uno storage account. L'utente segnala che vede l'account nel portale e può cambiarne la configurazione, ma non riesce a leggere il contenuto di un container di blob. Perché?",
 "opzione_a": "Storage Account Contributor grants management plane permissions only; reading blob data requires a role with data actions, such as Storage Blob Data Reader",
 "opzione_a_it": "Storage Account Contributor concede permessi solo sul piano di gestione; leggere i dati dei blob richiede un ruolo con data action, come Storage Blob Data Reader",
 "opzione_b": "The role assignment has not finished propagating and will work within 24 hours",
 "opzione_b_it": "L'assegnazione di ruolo non ha finito di propagarsi e funzionerà entro 24 ore",
 "opzione_c": "The container's public access level is set to Private",
 "opzione_c_it": "Il livello di accesso pubblico del container è impostato su Private",
 "opzione_d": "Storage Account Contributor must be assigned at subscription scope to include data access",
 "opzione_d_it": "Storage Account Contributor deve essere assegnato con ambito subscription per includere l'accesso ai dati",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Azure RBAC separates the management plane from the data plane. Storage Account Contributor lets you manage the account resource - keys, configuration, deletion - through Actions, but it contains no DataActions, so it grants no access to blob, file, queue or table contents. Data access needs a data role such as Storage Blob Data Reader or Storage Blob Data Contributor. Why the others are wrong: (b) role assignments generally take effect within minutes, and a propagation delay would not produce this consistent split between configuration and data. (c) Private access level blocks anonymous callers; an authorized principal with the right data role reads the container regardless. (d) scope changes which resources a role covers, never which actions it contains - assigning the same role higher up adds breadth, not data permissions.",
 "spiegazione_it": "Corretta: a. Azure RBAC separa il piano di gestione dal piano dati. Storage Account Contributor consente di gestire la risorsa account - chiavi, configurazione, eliminazione - tramite le Actions, ma non contiene alcuna DataAction, quindi non concede accesso al contenuto di blob, file, queue o table. L'accesso ai dati richiede un ruolo dati come Storage Blob Data Reader o Storage Blob Data Contributor. Perché le altre sono sbagliate: (b) le assegnazioni di ruolo diventano effettive in genere entro pochi minuti, e un ritardo di propagazione non produrrebbe questa separazione così netta e costante fra configurazione e dati. (c) il livello di accesso Private blocca i chiamanti anonimi; un principal autorizzato con il ruolo dati giusto legge il container comunque. (d) l'ambito cambia quali risorse un ruolo copre, mai quali azioni contiene: assegnare lo stesso ruolo più in alto aggiunge estensione, non permessi sui dati.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/role-based-access-control/built-in-roles#storage-account-contributor",
 "tags": "rbac, storage account contributor, data action, piano di gestione"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage built-in Azure roles",
 "tipo": "hotspot",
 "difficolta": 2,
 "domanda": "You must choose the least-privileged built-in Azure role for each task. Select the appropriate option for each requirement.",
 "domanda_it": "Devi scegliere il ruolo Azure predefinito con il minor privilegio per ogni compito. Seleziona l'opzione appropriata per ogni requisito.",
 "opzione_a": "Grant a colleague the ability to create and manage every resource in a resource group, but not to grant access to others: [Contributor | Owner | User Access Administrator]",
 "opzione_a_it": "Consentire a un collega di creare e gestire ogni risorsa di un resource group, ma non di concedere accesso ad altri: [Contributor | Owner | User Access Administrator]",
 "opzione_b": "Grant an auditor the ability to view every resource in a subscription without changing anything: [Reader | Contributor | Monitoring Reader]",
 "opzione_b_it": "Consentire a un revisore di visualizzare ogni risorsa di una subscription senza modificare nulla: [Reader | Contributor | Monitoring Reader]",
 "opzione_c": "Grant a security lead the ability to assign roles to other people, without the ability to manage the resources themselves: [User Access Administrator | Owner | Contributor]",
 "opzione_c_it": "Consentire a un responsabile della sicurezza di assegnare ruoli ad altre persone, senza poter gestire le risorse: [User Access Administrator | Owner | Contributor]",
 "opzione_d": "",
 "opzione_d_it": "",
 "opzione_e": "",
 "opzione_e_it": "",
 "risposta_corretta": "Contributor,Reader,User Access Administrator",
 "spiegazione": "Dropdown 1 - 'Contributor': Contributor grants full management of resources but explicitly excludes granting access, because its NotActions subtract the Microsoft.Authorization write permissions. Owner would also work but adds the access-granting power the requirement forbids, so it is not least-privileged. Dropdown 2 - 'Reader': Reader is view-only across everything in the scope. Contributor is far too much for an auditor, and Monitoring Reader is narrower than required - it covers monitoring data, not every resource. Dropdown 3 - 'User Access Administrator': this role manages user access to Azure resources and nothing else, which is exactly the separation described. Owner would grant resource management too, and Contributor is the one role that specifically cannot assign roles.",
 "spiegazione_it": "Menu 1 corretto: 'Contributor'. Contributor concede la gestione completa delle risorse ma esclude esplicitamente la concessione di accesso, perché le sue NotActions sottraggono i permessi di scrittura su Microsoft.Authorization. Owner funzionerebbe anch'esso, ma aggiunge il potere di concedere accesso che il requisito vieta, quindi non è il privilegio minimo. Menu 2 corretto: 'Reader'. Reader è di sola visualizzazione su tutto ciò che sta nell'ambito. Contributor è molto più di quanto serva a un revisore, e Monitoring Reader è più stretto del richiesto: copre i dati di monitoraggio, non ogni risorsa. Menu 3 corretto: 'User Access Administrator'. Questo ruolo gestisce l'accesso degli utenti alle risorse Azure e nient'altro, che è esattamente la separazione descritta. Owner concederebbe anche la gestione delle risorse, e Contributor è proprio il ruolo che non può assegnare ruoli.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/role-based-access-control/built-in-roles",
 "tags": "rbac, contributor, reader, user access administrator, privilegio minimo"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage built-in Azure roles",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "A user holds the Reader role at subscription scope and the Contributor role on a resource group inside that subscription. What can the user do in that resource group?",
 "domanda_it": "Un utente ha il ruolo Reader con ambito subscription e il ruolo Contributor su un resource group interno a quella subscription. Cosa può fare l'utente in quel resource group?",
 "opzione_a": "Manage resources, because Azure RBAC permissions are additive and the most permissive assignment applies",
 "opzione_a_it": "Gestire le risorse, perché i permessi Azure RBAC sono additivi e vale l'assegnazione più permissiva",
 "opzione_b": "Only read resources, because the assignment at the higher scope takes precedence",
 "opzione_b_it": "Solo leggere le risorse, perché l'assegnazione con ambito più alto ha la precedenza",
 "opzione_c": "Nothing, because two conflicting assignments cancel each other out",
 "opzione_c_it": "Niente, perché due assegnazioni in conflitto si annullano a vicenda",
 "opzione_d": "Manage resources only after the Reader assignment is removed",
 "opzione_d_it": "Gestire le risorse solo dopo la rimozione dell'assegnazione Reader",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Azure RBAC assignments are additive: a principal's effective permissions are the union of every role assigned to it at every scope that applies. Reader inherited from the subscription plus Contributor on the resource group means the user can manage resources in that resource group and read everywhere else in the subscription. Why the others are wrong: (b) a broader scope does not override a narrower one; inheritance flows downward and adds, it does not cap. (c) roles never cancel each other - only a deny assignment can subtract, and deny assignments are created by Azure, not by role assignments. (d) removing Reader would reduce the user's access elsewhere and change nothing inside the resource group, where Contributor already applies.",
 "spiegazione_it": "Corretta: a. Le assegnazioni Azure RBAC sono additive: i permessi effettivi di un principal sono l'unione di ogni ruolo assegnatogli a ogni ambito applicabile. Reader ereditato dalla subscription più Contributor sul resource group significa che l'utente può gestire le risorse di quel resource group e leggere ovunque altro nella subscription. Perché le altre sono sbagliate: (b) un ambito più ampio non prevale su uno più stretto: l'ereditarietà scende verso il basso e somma, non pone un tetto. (c) i ruoli non si annullano mai a vicenda: solo una deny assignment può sottrarre, e le deny assignment le crea Azure, non le assegnazioni di ruolo. (d) rimuovere Reader ridurrebbe l'accesso dell'utente altrove e non cambierebbe nulla dentro il resource group, dove Contributor si applica già.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/role-based-access-control/overview#multiple-role-assignments",
 "tags": "rbac, permessi additivi, ambito, ereditarietà"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage resource groups",
 "tipo": "yes_no_series",
 "difficolta": 2,
 "domanda": "You are reviewing how resource groups behave. For each statement, select Yes if the statement is true. Otherwise, select No.",
 "domanda_it": "Stai esaminando il comportamento dei resource group. Per ogni affermazione scegli Sì se è vera, altrimenti No.",
 "opzione_a": "A resource group can contain resources located in regions other than the resource group's own location.",
 "opzione_a_it": "Un resource group può contenere risorse situate in region diverse dalla location del resource group stesso.",
 "opzione_b": "A resource can belong to more than one resource group at the same time.",
 "opzione_b_it": "Una risorsa può appartenere a più di un resource group contemporaneamente.",
 "opzione_c": "Deleting a resource group deletes every resource inside it.",
 "opzione_c_it": "Eliminare un resource group elimina ogni risorsa al suo interno.",
 "risposta_corretta": "yes,no,yes",
 "spiegazione": "Statement 1 - Yes. The location of a resource group determines only where its metadata is stored; the resources inside it can live in any region. Statement 2 - No. Each resource belongs to exactly one resource group. It can be moved to another group, but never held by two at once - which is why the resource group is a genuine lifecycle boundary rather than a tag. Statement 3 - Yes, and this is the behaviour that makes resource groups both convenient and dangerous: deletion cascades to everything inside, which is the intended way to tear down an environment and the reason delete locks exist.",
 "spiegazione_it": "L'affermazione 1 è Sì. La location di un resource group determina soltanto dove vengono archiviati i suoi metadati; le risorse al suo interno possono stare in qualsiasi region. L'affermazione 2 è No. Ogni risorsa appartiene a esattamente un resource group. Può essere spostata in un altro gruppo, ma mai essere tenuta da due contemporaneamente: è per questo che il resource group è un vero confine di ciclo di vita e non un'etichetta. L'affermazione 3 è Sì, ed è il comportamento che rende i resource group comodi e pericolosi insieme: l'eliminazione si propaga a tutto ciò che contengono, che è il modo previsto per smantellare un ambiente e la ragione per cui esistono i delete lock.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/manage-resource-groups-portal",
 "tags": "resource group, location, ciclo di vita, eliminazione"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage resource groups",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "You start a move of several resources from one resource group to another. What happens to the resources being moved while the operation is in progress?",
 "domanda_it": "Avvii lo spostamento di diverse risorse da un resource group a un altro. Cosa succede alle risorse coinvolte mentre l'operazione è in corso?",
 "opzione_a": "The source and target resource groups are locked, so write and delete operations on the resources are blocked until the move completes",
 "opzione_a_it": "Il resource group di origine e quello di destinazione vengono bloccati, quindi le operazioni di scrittura ed eliminazione sulle risorse sono impedite fino al completamento dello spostamento",
 "opzione_b": "The resources are stopped and restarted in the target resource group",
 "opzione_b_it": "Le risorse vengono arrestate e riavviate nel resource group di destinazione",
 "opzione_c": "The resources are unavailable to their users for the duration of the move",
 "opzione_c_it": "Le risorse restano indisponibili per i loro utenti per tutta la durata dello spostamento",
 "opzione_d": "Nothing changes; the move is purely a billing operation applied at the end of the month",
 "opzione_d_it": "Non cambia nulla; lo spostamento è una pura operazione di fatturazione applicata a fine mese",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. During a move Resource Manager locks the source and destination resource groups, which blocks write and delete operations on them until the operation finishes. Existing resources keep running and serving traffic - the lock is about the control plane, not the data plane. Why the others are wrong: (b) a move does not restart anything; the resource keeps its state and its identity, only the containing group changes. (c) the workload stays available, which is the whole point of the operation being metadata-level. (d) the move genuinely changes the resource's ID and its management grouping - it is not a deferred billing adjustment, though billing does follow the new group afterwards.",
 "spiegazione_it": "Corretta: a. Durante uno spostamento Resource Manager blocca il resource group di origine e quello di destinazione, impedendo su di essi le operazioni di scrittura ed eliminazione fino alla fine dell'operazione. Le risorse esistenti continuano a girare e a servire traffico: il blocco riguarda il piano di controllo, non quello dei dati. Perché le altre sono sbagliate: (b) uno spostamento non riavvia nulla; la risorsa conserva stato e identità, cambia solo il gruppo che la contiene. (c) il carico di lavoro resta disponibile, che è tutto il senso di un'operazione che agisce sui metadati. (d) lo spostamento cambia davvero l'ID della risorsa e il suo raggruppamento gestionale: non è un aggiustamento di fatturazione differito, anche se poi la fatturazione segue il nuovo gruppo.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/move-resource-group-and-subscription",
 "tags": "resource group, move, lock, resource manager"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Configure management groups",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must apply a single Azure Policy assignment so that it governs every subscription in your organization, including subscriptions created in the future. At which scope should you assign the policy?",
 "domanda_it": "Devi applicare una singola assegnazione di Azure Policy che governi ogni subscription dell'organizzazione, incluse quelle create in futuro. A quale ambito dovresti assegnare la policy?",
 "opzione_a": "The root management group",
 "opzione_a_it": "Il management group radice",
 "opzione_b": "Each subscription individually",
 "opzione_b_it": "Ogni singola subscription",
 "opzione_c": "A resource group replicated in each subscription",
 "opzione_c_it": "Un resource group replicato in ogni subscription",
 "opzione_d": "The default management group created with the first subscription",
 "opzione_d_it": "Il management group predefinito creato con la prima subscription",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Every subscription in a directory sits under the root management group, and new subscriptions are placed there by default unless directed elsewhere. Assigning at the root therefore covers the whole estate now and automatically covers whatever is created later, which is what the requirement asks for. Why the others are wrong: (b) per-subscription assignments work today but do not cover future subscriptions - somebody has to remember to repeat the assignment, which is exactly the failure the hierarchy exists to prevent. (c) a resource group scope is narrower still and would miss everything outside those groups. (d) the phrasing describes no real object; the root management group is created automatically for the directory, and there is no separate default group tied to the first subscription that would offer this guarantee.",
 "spiegazione_it": "Corretta: a. Ogni subscription di una directory sta sotto il management group radice, e le nuove subscription vi vengono collocate per impostazione predefinita se non indirizzate altrove. Assegnare alla radice copre quindi l'intero parco adesso e copre automaticamente ciò che verrà creato in seguito, che è quanto il requisito chiede. Perché le altre sono sbagliate: (b) le assegnazioni per singola subscription funzionano oggi ma non coprono le subscription future: qualcuno deve ricordarsi di ripetere l'assegnazione, che è esattamente il fallimento che la gerarchia esiste per prevenire. (c) l'ambito resource group è ancora più stretto e mancherebbe tutto ciò che sta fuori da quei gruppi. (d) la formulazione non descrive un oggetto reale: il management group radice viene creato automaticamente per la directory, e non esiste un gruppo predefinito separato legato alla prima subscription che offra questa garanzia.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/governance/management-groups/overview",
 "tags": "management group, root, policy, ambito, ereditarietà"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Configure management groups",
 "tipo": "multiple_response",
 "difficolta": 3,
 "domanda": "You are designing a management group hierarchy. Which statements about management groups are correct? Each correct answer presents part of the solution. Select all that apply.",
 "domanda_it": "Stai progettando una gerarchia di management group. Quali affermazioni sui management group sono corrette? Ogni risposta corretta rappresenta una parte della soluzione. Selezionale tutte.",
 "opzione_a": "A management group can have only one parent.",
 "opzione_a_it": "Un management group può avere un solo genitore.",
 "opzione_b": "A management group can contain both subscriptions and other management groups.",
 "opzione_b_it": "Un management group può contenere sia subscription sia altri management group.",
 "opzione_c": "The hierarchy supports up to six levels of depth, not counting the root level and the subscription level.",
 "opzione_c_it": "La gerarchia supporta fino a sei livelli di profondità, esclusi il livello radice e quello delle subscription.",
 "opzione_d": "A subscription can be placed under two management groups to inherit policies from both.",
 "opzione_d_it": "Una subscription può essere collocata sotto due management group per ereditare le policy da entrambi.",
 "opzione_e": "The root management group can be deleted once a custom hierarchy is in place.",
 "opzione_e_it": "Il management group radice può essere eliminato una volta creata una gerarchia personalizzata.",
 "risposta_corretta": "a,b,c",
 "spiegazione": "Correct: a, b and c. The hierarchy is a tree: each management group has exactly one parent, it can hold a mixture of child management groups and subscriptions, and Learn documents support for up to six levels of depth excluding the root level and the subscription level. Why the others are wrong: (d) a subscription, like a management group, has exactly one parent - the single-parent rule is what makes policy inheritance unambiguous, and multi-parenting would make the effective policy set undecidable. (e) the root management group cannot be moved or deleted; it is created automatically for the directory and every other node descends from it.",
 "spiegazione_it": "Corrette: a, b e c. La gerarchia è un albero: ogni management group ha esattamente un genitore, può contenere un misto di management group figli e subscription, e Learn documenta il supporto fino a sei livelli di profondità esclusi il livello radice e quello delle subscription. Perché le altre sono sbagliate: (d) una subscription, come un management group, ha esattamente un genitore: è la regola del genitore unico a rendere non ambigua l'ereditarietà delle policy, e la doppia appartenenza renderebbe indecidibile l'insieme di policy effettive. (e) il management group radice non si può spostare né eliminare: viene creato automaticamente per la directory e ogni altro nodo discende da esso.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/governance/management-groups/overview",
 "tags": "management group, gerarchia, profondità, genitore unico"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage costs by using alerts, budgets, and Azure Advisor recommendations",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must be warned when a subscription is projected to exceed its monthly budget, early enough to act before the money is actually spent. What should you configure?",
 "domanda_it": "Devi essere avvisato quando si prevede che una subscription supererà il budget mensile, con abbastanza anticipo da poter intervenire prima che la spesa avvenga davvero. Cosa dovresti configurare?",
 "opzione_a": "A budget with a forecasted alert condition",
 "opzione_a_it": "Un budget con una condizione di avviso di tipo previsionale",
 "opzione_b": "A budget with an actual alert condition",
 "opzione_b_it": "Un budget con una condizione di avviso di tipo effettivo",
 "opzione_c": "A metric alert rule on the subscription's cost metric",
 "opzione_c_it": "Una regola di avviso su metrica per la metrica di costo della subscription",
 "opzione_d": "An Azure Advisor cost recommendation digest",
 "opzione_d_it": "Un riepilogo delle raccomandazioni di costo di Azure Advisor",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Cost Management budgets support two alert conditions. A forecasted alert fires when Azure projects that spending will cross the threshold within the period, which gives you notice before the money is gone. Why the others are wrong: (b) an actual alert fires only once the spend has already crossed the threshold, which is too late for the requirement as stated - the distinction between actual and forecasted is what this question tests. (c) cost is not exposed as an Azure Monitor metric you can alert on; budgets are the mechanism for spending thresholds. (d) Advisor recommends ways to reduce cost, such as right-sizing or shutting down idle resources, but it does not watch a budget threshold or notify you about projected overspend.",
 "spiegazione_it": "Corretta: a. I budget di Cost Management supportano due condizioni di avviso. Un avviso previsionale scatta quando Azure prevede che la spesa supererà la soglia entro il periodo, e questo ti dà preavviso prima che il denaro sia speso. Perché le altre sono sbagliate: (b) un avviso effettivo scatta solo quando la spesa ha già superato la soglia, il che è troppo tardi rispetto al requisito dichiarato: è proprio la distinzione fra effettivo e previsionale che questa domanda mette alla prova. (c) il costo non è esposto come metrica di Azure Monitor su cui creare avvisi; il meccanismo per le soglie di spesa sono i budget. (d) Advisor suggerisce modi per ridurre la spesa, come il ridimensionamento o lo spegnimento di risorse inattive, ma non sorveglia una soglia di budget né ti avvisa di uno sforamento previsto.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/cost-management-billing/costs/cost-mgt-alerts-monitor-usage-spending",
 "tags": "budget, avviso previsionale, cost management, advisor"
},
{
 "batch_id": "IDG-J",
 "dominio": "Manage Azure identities and governance",
 "sotto_argomento": "Manage costs by using alerts, budgets, and Azure Advisor recommendations",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "Azure Advisor reports a cost recommendation to right-size or shut down a virtual machine. On what does Advisor base this recommendation?",
 "domanda_it": "Azure Advisor segnala una raccomandazione di costo per ridimensionare o spegnere una macchina virtuale. Su cosa si basa Advisor per questa raccomandazione?",
 "opzione_a": "Observed utilization telemetry for the virtual machine over a recent period",
 "opzione_a_it": "La telemetria di utilizzo osservata per la macchina virtuale in un periodo recente",
 "opzione_b": "The tags applied to the virtual machine",
 "opzione_b_it": "I tag applicati alla macchina virtuale",
 "opzione_c": "The budget threshold configured on the subscription",
 "opzione_c_it": "La soglia di budget configurata sulla subscription",
 "opzione_d": "The resource group's location",
 "opzione_d_it": "La location del resource group",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Advisor's cost recommendations for virtual machines come from analysing actual utilization telemetry - chiefly CPU and network - over a recent evaluation window, and flagging machines whose usage is consistently far below the size they are paying for. Why the others are wrong: (b) tags are metadata for organization and billing breakdown; Advisor does not infer waste from them. (c) a budget threshold governs alerting on spend and is independent of Advisor's per-resource analysis. (d) a resource group's location is metadata only and has no bearing on whether a machine is oversized.",
 "spiegazione_it": "Corretta: a. Le raccomandazioni di costo di Advisor per le macchine virtuali nascono dall'analisi della telemetria di utilizzo reale - soprattutto CPU e rete - su una finestra di valutazione recente, e segnalano le macchine il cui uso resta costantemente molto al di sotto della dimensione che stai pagando. Perché le altre sono sbagliate: (b) i tag sono metadati per l'organizzazione e la ripartizione dei costi; Advisor non deduce da essi alcuno spreco. (c) una soglia di budget governa gli avvisi sulla spesa ed è indipendente dall'analisi per singola risorsa di Advisor. (d) la location di un resource group è solo un metadato e non incide sul fatto che una macchina sia sovradimensionata.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/advisor/advisor-reference-cost-recommendations",
 "tags": "azure advisor, right-size, telemetria, costo"
}
]
