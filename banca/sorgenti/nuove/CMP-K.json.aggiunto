[
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Create an App Service",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "Contoso runs an App Service plan named plan-prod in West Europe. The plan is a Standard S1 plan created with the Windows operating system and it already hosts two web apps. A developer must deploy a new web app that runs a custom Linux container image from Azure Container Registry. The solution must minimize cost. What should you do?",
 "domanda_it": "Contoso ha un App Service plan denominato plan-prod in West Europe. È un piano Standard S1 creato con sistema operativo Windows e ospita già due app web. Uno sviluppatore deve distribuire una nuova app web che esegue un'immagine container Linux personalizzata da Azure Container Registry. La soluzione deve ridurre al minimo i costi. Cosa dovresti fare?",
 "opzione_a": "Create the new web app in plan-prod and set the publishing model to Container.",
 "opzione_a_it": "Creare la nuova app web in plan-prod e impostare il modello di pubblicazione su Container.",
 "opzione_b": "Create a new Linux App Service plan in West Europe and create the web app in that plan.",
 "opzione_b_it": "Creare un nuovo App Service plan Linux in West Europe e creare l'app web in quel piano.",
 "opzione_c": "Change the operating system of plan-prod to Linux, then create the web app in plan-prod.",
 "opzione_c_it": "Cambiare il sistema operativo di plan-prod in Linux, poi creare l'app web in plan-prod.",
 "opzione_d": "Scale plan-prod up to Premium v3, which supports both Windows and Linux workloads in the same plan.",
 "opzione_d_it": "Scalare plan-prod a Premium v3, che supporta carichi Windows e Linux nello stesso piano.",
 "opzione_e": "",
 "opzione_e_it": "",
 "risposta_corretta": "b",
 "spiegazione": "Correct: b. An App Service plan carries an operating system that is fixed when the plan is created, and Windows apps and Linux apps cannot share the same plan. To host a Linux container you need a Linux plan, so a second plan in the same region is the only workable option; the two plans are billed separately but no cheaper arrangement exists. Why the others are wrong: (a) a Windows plan cannot run a Linux container app, so the app cannot be created there. (c) the operating system of an existing plan cannot be changed after creation - there is no such setting. (d) Premium v3 exists for both Windows and Linux, but the tier does not remove the one-OS-per-plan rule, and scaling up would raise the bill without solving the problem.",
 "spiegazione_it": "Corretta: b. Un App Service plan porta con sé un sistema operativo che viene fissato alla creazione del piano, e app Windows e app Linux non possono condividere lo stesso piano. Per ospitare un container Linux serve un piano Linux, quindi un secondo piano nella stessa region è l'unica strada percorribile: i due piani vengono fatturati separatamente, ma non esiste una soluzione più economica. Perché le altre sono sbagliate: (a) un piano Windows non può eseguire un'app container Linux, quindi l'app non si può creare lì. (c) il sistema operativo di un piano esistente non si può cambiare dopo la creazione: quell'impostazione non esiste. (d) Premium v3 esiste sia per Windows sia per Linux, ma il tier non elimina la regola di un solo sistema operativo per piano, e scalare farebbe salire la spesa senza risolvere il problema.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/overview-hosting-plans",
 "tags": "app service, app service plan, linux, container"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Create an App Service",
 "tipo": "hotspot",
 "difficolta": 2,
 "domanda": "You are creating a web app in the Azure portal. You must choose values that satisfy these requirements: the app name must be reachable on the public internet without buying a domain, the app must run .NET code without you managing a container image, and the app must be able to use deployment slots. Select the appropriate option for each requirement.",
 "domanda_it": "Stai creando un'app web nel portale Azure. Devi scegliere valori che soddisfino questi requisiti: il nome dell'app deve essere raggiungibile da internet senza acquistare un dominio, l'app deve eseguire codice .NET senza che tu gestisca un'immagine container, e l'app deve poter usare i deployment slot. Seleziona l'opzione appropriata per ogni requisito.",
 "opzione_a": "Default DNS suffix assigned to the app: [<name>.azurewebsites.net | <name>.cloudapp.azure.com | <name>.azurecontainer.io]",
 "opzione_a_it": "Suffisso DNS predefinito assegnato all'app: [<name>.azurewebsites.net | <name>.cloudapp.azure.com | <name>.azurecontainer.io]",
 "opzione_b": "Publish setting to select: [Code | Container | Static Web App]",
 "opzione_b_it": "Impostazione Publish da selezionare: [Code | Container | Static Web App]",
 "opzione_c": "Minimum pricing tier that provides deployment slots: [Free F1 | Basic B1 | Standard S1]",
 "opzione_c_it": "Tier di prezzo minimo che fornisce i deployment slot: [Free F1 | Basic B1 | Standard S1]",
 "opzione_d": "Scope in which the app name must be unique: [Global, across all of Azure | The resource group | The subscription]",
 "opzione_d_it": "Ambito in cui il nome dell'app deve essere univoco: [Globale, in tutto Azure | Il resource group | La subscription]",
 "opzione_e": "",
 "opzione_e_it": "",
 "risposta_corretta": "<name>.azurewebsites.net,Code,Standard S1,Global, across all of Azure",
 "spiegazione": "Dropdown 1 - '<name>.azurewebsites.net': App Service publishes every app on the shared azurewebsites.net domain, so the app is reachable immediately without a custom domain. cloudapp.azure.com belongs to classic cloud services and public IP addresses, and azurecontainer.io belongs to Azure Container Instances. Dropdown 2 - 'Code': the Code publishing option lets the platform host the .NET runtime for you; Container would require you to build and maintain an image, and Static Web App is a different service for static content with APIs. Dropdown 3 - 'Standard S1': deployment slots start at the Standard tier, which provides five slots; Premium provides twenty. Free and Basic provide no slots at all. Dropdown 4 - 'Global, across all of Azure': because the name becomes a host name under a shared public domain, it must be unique across every Azure customer, not merely within your resource group or subscription.",
 "spiegazione_it": "Menu a discesa 1 corretto: '<name>.azurewebsites.net'. App Service pubblica ogni app sul dominio condiviso azurewebsites.net, quindi l'app è raggiungibile subito senza dominio personalizzato. cloudapp.azure.com appartiene ai cloud service classic e agli indirizzi IP pubblici, azurecontainer.io ad Azure Container Instances. Menu 2 corretto: 'Code'. L'opzione di pubblicazione Code fa ospitare il runtime .NET alla piattaforma; Container richiederebbe di costruire e mantenere un'immagine, e Static Web App è un servizio diverso, per contenuti statici con API. Menu 3 corretto: 'Standard S1'. I deployment slot partono dal tier Standard, che ne fornisce cinque; Premium ne fornisce venti. Free e Basic non ne hanno affatto. Menu 4 corretto: 'Globale, in tutto Azure'. Poiché il nome diventa un host name sotto un dominio pubblico condiviso, deve essere univoco fra tutti i clienti Azure, non solo dentro il tuo resource group o la tua subscription.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/getting-started",
 "tags": "app service, azurewebsites.net, deployment slot, naming"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Create an App Service",
 "tipo": "multiple_response",
 "difficolta": 2,
 "domanda": "You must create an App Service web app by using the Azure CLI. Which values are required to create the app itself, assuming the App Service plan already exists? Each correct answer presents part of the solution. Select all that apply.",
 "domanda_it": "Devi creare un'app web di App Service usando l'Azure CLI. Quali valori sono necessari per creare l'app in sé, dato che l'App Service plan esiste già? Ogni risposta corretta rappresenta una parte della soluzione. Selezionale tutte.",
 "opzione_a": "The name of the resource group",
 "opzione_a_it": "Il nome del resource group",
 "opzione_b": "The name of the App Service plan",
 "opzione_b_it": "Il nome dell'App Service plan",
 "opzione_c": "A globally unique name for the app",
 "opzione_c_it": "Un nome globalmente univoco per l'app",
 "opzione_d": "The Azure region for the app",
 "opzione_d_it": "La region Azure per l'app",
 "opzione_e": "A storage account for the app content",
 "opzione_e_it": "Uno storage account per il contenuto dell'app",
 "risposta_corretta": "a,b,c",
 "spiegazione": "Correct: a, b and c. az webapp create requires --resource-group, --plan and --name: the app is placed in a resource group, attached to an existing plan, and given a name that becomes its host name under azurewebsites.net. Why the others are wrong: (d) the region is not a parameter of the app, because the app inherits the region of the App Service plan it is created in - that is why a plan and its apps are always co-located. (e) a web app does not require a storage account: App Service provides the file system for app content itself. A storage account is required for Azure Functions on the Consumption plan, which is a common source of confusion.",
 "spiegazione_it": "Corrette: a, b e c. az webapp create richiede --resource-group, --plan e --name: l'app viene collocata in un resource group, agganciata a un piano esistente e dotata di un nome che diventa il suo host name sotto azurewebsites.net. Perché le altre sono sbagliate: (d) la region non è un parametro dell'app, perché l'app eredita la region dell'App Service plan in cui viene creata: è per questo che un piano e le sue app stanno sempre nello stesso posto. (e) un'app web non richiede uno storage account: è App Service stesso a fornire il file system per il contenuto. Lo storage account serve invece ad Azure Functions sul piano Consumption, ed è una confusione frequente.",
 "url_riferimento": "https://learn.microsoft.com/en-us/cli/azure/webapp#az-webapp-create",
 "tags": "app service, azure cli, az webapp create"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Create an App Service",
 "tipo": "yes_no_series",
 "difficolta": 3,
 "domanda": "A colleague makes the following statements about creating apps in Azure App Service. For each statement, select Yes if the statement is true. Otherwise, select No.",
 "domanda_it": "Un collega fa le seguenti affermazioni sulla creazione di app in Azure App Service. Per ogni affermazione scegli Sì se è vera, altrimenti No.",
 "opzione_a": "An App Service plan can host apps that belong to different resource groups.",
 "opzione_a_it": "Un App Service plan può ospitare app che appartengono a resource group diversi.",
 "opzione_b": "You can create a web app in the Free F1 tier and later scale the same plan up to Standard S1.",
 "opzione_b_it": "Puoi creare un'app web nel tier Free F1 e in seguito scalare lo stesso piano a Standard S1.",
 "opzione_c": "Deleting the only web app in an App Service plan also deletes the plan and stops the charges.",
 "opzione_c_it": "Eliminando l'unica app web di un App Service plan si elimina anche il piano e cessano gli addebiti.",
 "risposta_corretta": "yes,yes,no",
 "spiegazione": "Statement 1 - Yes. The app and the plan must share a subscription and a region, but they are separate resources and may live in different resource groups. This is why deleting a resource group can leave an orphaned plan behind. Statement 2 - Yes. Scale up changes the pricing tier of an existing plan in place, and moving from Free to Standard is the normal path once an app needs custom domains, slots or Always On. The apps in the plan keep running. Statement 3 - No, and this is the expensive misunderstanding. An App Service plan is billed for the compute it reserves, not for the apps running on it: a plan with zero apps in a paid tier keeps charging. The plan must be deleted explicitly, or scaled down to Free, to stop the cost.",
 "spiegazione_it": "L'affermazione 1 è Sì. L'app e il piano devono condividere subscription e region, ma sono risorse distinte e possono stare in resource group diversi. È il motivo per cui eliminando un resource group si può lasciare indietro un piano orfano. L'affermazione 2 è Sì. Lo scale up cambia il tier di prezzo di un piano esistente sul posto, e passare da Free a Standard è il percorso normale quando un'app inizia ad avere bisogno di domini personalizzati, slot o Always On. Le app del piano continuano a funzionare. L'affermazione 3 è No, ed è il fraintendimento che costa caro. Un App Service plan viene fatturato per la capacità di calcolo che riserva, non per le app che ci girano sopra: un piano con zero app in un tier a pagamento continua ad addebitare. Il piano va eliminato esplicitamente, oppure riportato a Free, per fermare la spesa.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/overview-hosting-plans",
 "tags": "app service plan, billing, scale up"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure certificates and Transport Layer Security (TLS) for an App Service",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "A web app named app-shop runs in a Basic B1 App Service plan and has the custom domain shop.contoso.com already mapped and validated. You must secure the custom domain with HTTPS at no additional cost, and the certificate must renew automatically. What should you do?",
 "domanda_it": "Un'app web denominata app-shop gira in un App Service plan Basic B1 e ha già il dominio personalizzato shop.contoso.com mappato e convalidato. Devi proteggere il dominio personalizzato con HTTPS senza costi aggiuntivi, e il certificato deve rinnovarsi automaticamente. Cosa dovresti fare?",
 "opzione_a": "Create an App Service managed certificate for shop.contoso.com and add a TLS/SSL binding that uses SNI SSL.",
 "opzione_a_it": "Creare un App Service managed certificate per shop.contoso.com e aggiungere un binding TLS/SSL che usa SNI SSL.",
 "opzione_b": "Buy an App Service certificate and add a TLS/SSL binding that uses IP-based SSL.",
 "opzione_b_it": "Acquistare un App Service certificate e aggiungere un binding TLS/SSL che usa IP-based SSL.",
 "opzione_c": "Upload a self-signed .pfx certificate and add a TLS/SSL binding that uses SNI SSL.",
 "opzione_c_it": "Caricare un certificato .pfx autofirmato e aggiungere un binding TLS/SSL che usa SNI SSL.",
 "opzione_d": "Enable the HTTPS Only setting on app-shop, which issues a certificate for the custom domain automatically.",
 "opzione_d_it": "Abilitare l'impostazione HTTPS Only su app-shop, che emette automaticamente un certificato per il dominio personalizzato.",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. The App Service managed certificate is free, is issued and renewed automatically by the platform, and is available from the Basic tier upward, which app-shop meets. SNI SSL bindings are also free and unlimited. Why the others are wrong: (b) an App Service certificate is a purchased product, and IP-based SSL reserves a dedicated inbound IP address that carries an extra charge - both violate the no-cost requirement. (c) a self-signed certificate is free but browsers will not trust it, and nothing renews it automatically. (d) HTTPS Only only redirects HTTP requests to HTTPS; it does not create or bind any certificate, so the custom domain would still present a certificate mismatch.",
 "spiegazione_it": "Corretta: a. L'App Service managed certificate è gratuito, viene emesso e rinnovato automaticamente dalla piattaforma ed è disponibile dal tier Basic in su, requisito che app-shop soddisfa. Anche i binding SNI SSL sono gratuiti e illimitati. Perché le altre sono sbagliate: (b) un App Service certificate è un prodotto a pagamento, e IP-based SSL riserva un indirizzo IP in ingresso dedicato che comporta un costo aggiuntivo: entrambi violano il requisito di costo zero. (c) un certificato autofirmato è gratuito ma i browser non lo considerano attendibile, e niente lo rinnova automaticamente. (d) HTTPS Only si limita a reindirizzare le richieste HTTP verso HTTPS: non crea né associa alcun certificato, quindi il dominio personalizzato continuerebbe a presentare un certificato non corrispondente.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/configure-ssl-certificate",
 "tags": "app service, tls, managed certificate, sni ssl"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure certificates and Transport Layer Security (TLS) for an App Service",
 "tipo": "multiple_response",
 "difficolta": 3,
 "domanda": "You must upload an existing private certificate as a .pfx file to an App Service app so that it can be used in a TLS/SSL binding. Which requirements must the certificate meet? Each correct answer presents part of the solution. Select all that apply.",
 "domanda_it": "Devi caricare un certificato privato esistente come file .pfx su un'app di App Service perché possa essere usato in un binding TLS/SSL. Quali requisiti deve soddisfare il certificato? Ogni risposta corretta rappresenta una parte della soluzione. Selezionale tutte.",
 "opzione_a": "It must be password protected.",
 "opzione_a_it": "Deve essere protetto da password.",
 "opzione_b": "It must contain the private key.",
 "opzione_b_it": "Deve contenere la chiave privata.",
 "opzione_c": "It must use a key at least 2048 bits long.",
 "opzione_c_it": "Deve usare una chiave lunga almeno 2048 bit.",
 "opzione_d": "It must be issued by an internal certificate authority.",
 "opzione_d_it": "Deve essere emesso da una certification authority interna.",
 "opzione_e": "It must be stored in an Azure Key Vault in the same resource group as the app.",
 "opzione_e_it": "Deve essere archiviato in un Azure Key Vault nello stesso resource group dell'app.",
 "risposta_corretta": "a,b,c",
 "spiegazione": "Correct: a, b and c. Learn lists the requirements for a private certificate uploaded to App Service: it is exported as a password-protected PFX file, it contains the private key at least 2048 bits long, and it contains all intermediate certificates in the chain. Why the others are wrong: (d) the opposite is true for a public-facing site - a certificate from an internal CA is not trusted by browsers; the certificate must be signed by a trusted certificate authority. (e) importing from Key Vault is one supported route, but it is not a requirement, and the vault does not need to share the resource group with the app.",
 "spiegazione_it": "Corrette: a, b e c. Learn elenca i requisiti di un certificato privato caricato su App Service: viene esportato come file PFX protetto da password, contiene la chiave privata lunga almeno 2048 bit e contiene tutti i certificati intermedi della catena. Perché le altre sono sbagliate: (d) per un sito esposto al pubblico vale l'opposto: un certificato emesso da una CA interna non è considerato attendibile dai browser; il certificato deve essere firmato da una certification authority attendibile. (e) l'importazione da Key Vault è una delle strade supportate, ma non è un requisito, e il vault non deve stare nello stesso resource group dell'app.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/configure-ssl-certificate#private-certificate-requirements",
 "tags": "app service, tls, pfx, private certificate"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure backup for an App Service",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You attempt to configure a custom backup for a web app that runs in a Basic B1 App Service plan. The Backups blade reports that the feature is not available. You must enable custom backups while keeping the cost as low as possible. What should you do?",
 "domanda_it": "Provi a configurare un backup personalizzato per un'app web che gira in un App Service plan Basic B1. Il pannello Backups segnala che la funzionalità non è disponibile. Devi abilitare i backup personalizzati mantenendo il costo più basso possibile. Cosa dovresti fare?",
 "opzione_a": "Scale the App Service plan up to Standard.",
 "opzione_a_it": "Scalare l'App Service plan a Standard.",
 "opzione_b": "Scale the App Service plan up to Premium v3.",
 "opzione_b_it": "Scalare l'App Service plan a Premium v3.",
 "opzione_c": "Scale the App Service plan out to two instances.",
 "opzione_c_it": "Scalare l'App Service plan a due istanze.",
 "opzione_d": "Create a storage account with a private endpoint and select it on the Backups blade.",
 "opzione_d_it": "Creare uno storage account con un private endpoint e selezionarlo nel pannello Backups.",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. The backup and restore feature of App Service requires the Standard, Premium or Isolated tier. Standard is the lowest of the three, so scaling up to Standard satisfies the requirement at the smallest cost. Why the others are wrong: (b) Premium v3 does support backups, but it is more expensive than Standard and the question asks for the cheapest option that works. (c) scaling out adds instances of the same tier; it multiplies the bill without unlocking any tier-gated feature. (d) the tier is the blocker, not the storage account - and a storage account protected by a firewall or private endpoint is in fact not supported as a backup destination.",
 "spiegazione_it": "Corretta: a. La funzionalità di backup e ripristino di App Service richiede il tier Standard, Premium o Isolated. Standard è il più basso dei tre, quindi scalare a Standard soddisfa il requisito al costo minore. Perché le altre sono sbagliate: (b) Premium v3 supporta i backup, ma costa più di Standard e la domanda chiede l'opzione funzionante più economica. (c) lo scale out aggiunge istanze dello stesso tier: moltiplica la spesa senza sbloccare nessuna funzionalità legata al tier. (d) il blocco è il tier, non lo storage account, e anzi uno storage account protetto da firewall o private endpoint non è supportato come destinazione di backup.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/manage-backup",
 "tags": "app service, backup, standard tier"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure backup for an App Service",
 "tipo": "yes_no_series",
 "difficolta": 3,
 "domanda": "You are reviewing the custom backup configuration of an App Service app. For each statement, select Yes if the statement is true. Otherwise, select No.",
 "domanda_it": "Stai esaminando la configurazione dei backup personalizzati di un'app di App Service. Per ogni affermazione scegli Sì se è vera, altrimenti No.",
 "opzione_a": "A custom backup can include a linked Azure SQL Database in the same backup operation as the app content.",
 "opzione_a_it": "Un backup personalizzato può includere un database Azure SQL collegato nella stessa operazione di backup del contenuto dell'app.",
 "opzione_b": "A backup can be restored into a different App Service app.",
 "opzione_b_it": "Un backup può essere ripristinato in un'app di App Service diversa.",
 "opzione_c": "A single custom backup can exceed 10 GB provided the storage account has enough capacity.",
 "opzione_c_it": "Un singolo backup personalizzato può superare i 10 GB, purché lo storage account abbia capacità sufficiente.",
 "risposta_corretta": "yes,yes,no",
 "spiegazione": "Statement 1 - Yes. Custom backups can include databases linked to the app, and Azure SQL Database is one of the supported types along with Azure Database for MySQL and Azure Database for PostgreSQL. Statement 2 - Yes. A backup can be restored over the original app or into a different app, which is the supported way to clone an app into a new environment. Statement 3 - No. Learn states that a backup can be up to 10 GB of app and database content, and the operation fails beyond that size regardless of how much room the storage account has. The 10 GB ceiling is a limit of the feature, not of the destination.",
 "spiegazione_it": "L'affermazione 1 è Sì. I backup personalizzati possono includere i database collegati all'app, e Azure SQL Database è uno dei tipi supportati insieme ad Azure Database for MySQL e Azure Database for PostgreSQL. L'affermazione 2 è Sì. Un backup può essere ripristinato sull'app originale oppure in un'app diversa, ed è il modo supportato per clonare un'app in un nuovo ambiente. L'affermazione 3 è No. Learn afferma che un backup può arrivare a 10 GB di contenuto fra app e database, e l'operazione fallisce oltre quella dimensione a prescindere dallo spazio disponibile sullo storage account. Il tetto di 10 GB è un limite della funzionalità, non della destinazione.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/manage-backup",
 "tags": "app service, backup, restore, limiti"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Map an existing custom DNS name to an App Service",
 "tipo": "hotspot",
 "difficolta": 3,
 "domanda": "You must map the apex domain contoso.com to a web app named app-web1. Your DNS provider does not support ALIAS records. Select the appropriate option for each requirement.",
 "domanda_it": "Devi mappare il dominio apex contoso.com a un'app web denominata app-web1. Il tuo provider DNS non supporta i record ALIAS. Seleziona l'opzione appropriata per ogni requisito.",
 "opzione_a": "Record type that maps contoso.com to the app: [A record pointing to the inbound IP address of the app | CNAME record pointing to app-web1.azurewebsites.net | MX record pointing to app-web1.azurewebsites.net]",
 "opzione_a_it": "Tipo di record che mappa contoso.com all'app: [Record A che punta all'indirizzo IP in ingresso dell'app | Record CNAME che punta a app-web1.azurewebsites.net | Record MX che punta a app-web1.azurewebsites.net]",
 "opzione_b": "Additional record required so that Azure can verify domain ownership: [A TXT record named asuid.contoso.com holding the Custom Domain Verification ID | A TXT record named _acme-challenge.contoso.com holding the app name | An SRV record named _azure._tcp.contoso.com]",
 "opzione_b_it": "Record aggiuntivo necessario perché Azure possa verificare la proprietà del dominio: [Un record TXT denominato asuid.contoso.com che contiene il Custom Domain Verification ID | Un record TXT denominato _acme-challenge.contoso.com che contiene il nome dell'app | Un record SRV denominato _azure._tcp.contoso.com]",
 "opzione_c": "Minimum pricing tier required to map a custom domain: [Free F1 | Shared D1 | Premium v3 P1V3]",
 "opzione_c_it": "Tier di prezzo minimo necessario per mappare un dominio personalizzato: [Free F1 | Shared D1 | Premium v3 P1V3]",
 "opzione_d": "",
 "opzione_d_it": "",
 "opzione_e": "",
 "opzione_e_it": "",
 "risposta_corretta": "A record pointing to the inbound IP address of the app,A TXT record named asuid.contoso.com holding the Custom Domain Verification ID,Shared D1",
 "spiegazione": "Dropdown 1 - 'A record pointing to the inbound IP address of the app': a CNAME cannot be created at the apex of a zone because the apex already carries SOA and NS records, so without ALIAS support the only option is an A record pointing at the app's inbound IP address. An MX record is for mail routing and is irrelevant here. Dropdown 2 - 'A TXT record named asuid.contoso.com holding the Custom Domain Verification ID': Azure verifies ownership through a TXT record prefixed with asuid, whose value is the Custom Domain Verification ID shown on the app's Custom domains blade. _acme-challenge belongs to the ACME protocol used by Let's Encrypt, not to App Service domain verification. Dropdown 3 - 'Shared D1': custom domains are not available on Free F1; Shared D1 is the lowest tier that allows them. Premium v3 works but is far from the minimum.",
 "spiegazione_it": "Menu 1 corretto: 'Record A che punta all'indirizzo IP in ingresso dell'app'. Un CNAME non si può creare sull'apex di una zona, perché l'apex porta già i record SOA e NS: senza supporto ALIAS l'unica strada è un record A che punta all'indirizzo IP in ingresso dell'app. Un record MX serve all'instradamento della posta ed è irrilevante qui. Menu 2 corretto: 'Un record TXT denominato asuid.contoso.com che contiene il Custom Domain Verification ID'. Azure verifica la proprietà tramite un record TXT con prefisso asuid, il cui valore è il Custom Domain Verification ID mostrato nel pannello Custom domains dell'app. _acme-challenge appartiene al protocollo ACME usato da Let's Encrypt, non alla verifica dei domini di App Service. Menu 3 corretto: 'Shared D1'. I domini personalizzati non sono disponibili su Free F1; Shared D1 è il tier più basso che li consente. Premium v3 funziona ma è ben lontano dal minimo.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/app-service-web-tutorial-custom-domain",
 "tags": "app service, custom domain, dns, apex, asuid"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure networking settings for an App Service",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "A web app named app-api must reach a database server that has a private IP address in a virtual network named vnet-core. Inbound access to app-api must remain on the public internet. You must configure the app with the least administrative effort. What should you configure?",
 "domanda_it": "Un'app web denominata app-api deve raggiungere un server di database che ha un indirizzo IP privato in una virtual network denominata vnet-core. L'accesso in ingresso ad app-api deve restare su internet pubblico. Devi configurare l'app con il minimo sforzo amministrativo. Cosa dovresti configurare?",
 "opzione_a": "Regional virtual network integration with a subnet in vnet-core that is delegated to Microsoft.Web/serverFarms",
 "opzione_a_it": "Regional virtual network integration con una subnet in vnet-core delegata a Microsoft.Web/serverFarms",
 "opzione_b": "A private endpoint for app-api in a subnet of vnet-core",
 "opzione_b_it": "Un private endpoint per app-api in una subnet di vnet-core",
 "opzione_c": "A service endpoint for Microsoft.Web on the subnet that hosts the database server",
 "opzione_c_it": "Un service endpoint per Microsoft.Web sulla subnet che ospita il server di database",
 "opzione_d": "An App Service Environment v3 deployed into vnet-core",
 "opzione_d_it": "Un App Service Environment v3 distribuito in vnet-core",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Regional virtual network integration is the outbound feature of App Service: it gives the app a route into the virtual network so it can call private IP addresses, while the app keeps its public inbound endpoint. The integration subnet must be empty of other resources and delegated to Microsoft.Web/serverFarms. Why the others are wrong: (b) a private endpoint controls inbound traffic - it gives the app a private IP that clients connect to - which would remove the public inbound access the question requires, and it does nothing for outbound calls. (c) service endpoints secure access to PaaS services from a subnet; they do not give an App Service app a path into a virtual network. (d) an App Service Environment would work but is a large, expensive, single-tenant deployment - the opposite of least administrative effort.",
 "spiegazione_it": "Corretta: a. La regional virtual network integration è la funzionalità in uscita di App Service: dà all'app una via verso la virtual network per chiamare indirizzi IP privati, mentre l'app mantiene il suo endpoint pubblico in ingresso. La subnet di integrazione deve essere priva di altre risorse e delegata a Microsoft.Web/serverFarms. Perché le altre sono sbagliate: (b) un private endpoint governa il traffico in ingresso, dando all'app un IP privato a cui i client si connettono: eliminerebbe l'accesso pubblico in ingresso richiesto dalla domanda e non fa nulla per le chiamate in uscita. (c) i service endpoint proteggono l'accesso ai servizi PaaS da una subnet, non forniscono a un'app di App Service una via verso la virtual network. (d) un App Service Environment funzionerebbe, ma è una distribuzione single-tenant grande e costosa: l'opposto del minimo sforzo amministrativo.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/overview-vnet-integration",
 "tags": "app service, vnet integration, delegation, private endpoint"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Configure deployment slots for an App Service",
 "tipo": "multiple_response",
 "difficolta": 3,
 "domanda": "You swap a staging slot into the production slot of an App Service app. Which settings stay with the slot rather than moving with the swapped content? Each correct answer presents part of the solution. Select all that apply.",
 "domanda_it": "Esegui lo swap di uno slot di staging nello slot di produzione di un'app di App Service. Quali impostazioni restano legate allo slot invece di spostarsi con il contenuto scambiato? Ogni risposta corretta rappresenta una parte della soluzione. Selezionale tutte.",
 "opzione_a": "Custom domain names",
 "opzione_a_it": "I nomi di dominio personalizzati",
 "opzione_b": "Scale settings, such as the number of instances",
 "opzione_b_it": "Le impostazioni di scalabilità, come il numero di istanze",
 "opzione_c": "Non-public certificates and TLS/SSL settings",
 "opzione_c_it": "I certificati non pubblici e le impostazioni TLS/SSL",
 "opzione_d": "General settings, such as the framework version and 32/64-bit mode",
 "opzione_d_it": "Le impostazioni generali, come la versione del framework e la modalità 32/64 bit",
 "opzione_e": "Connection strings that are not marked as deployment slot settings",
 "opzione_e_it": "Le stringhe di connessione non contrassegnate come deployment slot setting",
 "risposta_corretta": "a,b,c",
 "spiegazione": "Correct: a, b and c. Learn divides configuration into settings that are swapped and settings that are not. Custom domain names, scale settings, and non-public certificates and TLS/SSL settings all belong to the slot itself and stay put - which is what makes the swap safe, because production keeps its own hostname, its own instance count and its own certificate bindings. Why the others are wrong: (d) general settings such as framework version and bitness are swapped along with the content, which is precisely why you can validate a runtime change in staging before it reaches production. (e) app settings and connection strings are swapped by default; they only stay behind when you tick the deployment slot setting box, which the option explicitly rules out.",
 "spiegazione_it": "Corrette: a, b e c. Learn divide la configurazione fra impostazioni che vengono scambiate e impostazioni che non lo sono. I nomi di dominio personalizzati, le impostazioni di scalabilità e i certificati non pubblici con le relative impostazioni TLS/SSL appartengono allo slot stesso e restano dove sono: è ciò che rende sicuro lo swap, perché la produzione conserva il proprio hostname, il proprio numero di istanze e i propri binding di certificato. Perché le altre sono sbagliate: (d) le impostazioni generali come la versione del framework e la modalità a 32 o 64 bit vengono scambiate insieme al contenuto, ed è esattamente il motivo per cui puoi validare un cambio di runtime in staging prima che arrivi in produzione. (e) le app setting e le stringhe di connessione vengono scambiate per impostazione predefinita; restano indietro solo se spunti la casella deployment slot setting, che l'opzione esclude esplicitamente.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/app-service/deploy-staging-slots#which-settings-are-swapped",
 "tags": "app service, deployment slot, swap, slot setting"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Modify an existing Azure Resource Manager template",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "An ARM template deploys a single storage account. You must modify the template so that it deploys five storage accounts whose names are built from a base name and an index, without duplicating the resource block. Which element should you add to the resource?",
 "domanda_it": "Un template ARM distribuisce un singolo storage account. Devi modificare il template perché ne distribuisca cinque, con nomi costruiti da un nome base e un indice, senza duplicare il blocco della risorsa. Quale elemento dovresti aggiungere alla risorsa?",
 "opzione_a": "A copy element that specifies a name and a count",
 "opzione_a_it": "Un elemento copy che specifica un name e un count",
 "opzione_b": "A dependsOn array that lists the five account names",
 "opzione_b_it": "Un array dependsOn che elenca i cinque nomi di account",
 "opzione_c": "A condition property set to greaterOrEquals(5)",
 "opzione_c_it": "Una proprietà condition impostata su greaterOrEquals(5)",
 "opzione_d": "A nested deployment resource of type Microsoft.Resources/deployments with a batchSize of 5",
 "opzione_d_it": "Una risorsa di distribuzione annidata di tipo Microsoft.Resources/deployments con batchSize pari a 5",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. The copy element is the ARM template iteration construct: placed on a resource, it takes a name for the loop and a count, and Resource Manager creates that many instances. copyIndex() then supplies the index used to build a unique name, for example concat(parameters('baseName'), copyIndex()). Why the others are wrong: (b) dependsOn only orders deployment; it never creates resources. (c) condition decides whether a single resource is deployed at all - it is a boolean gate, not a loop, and greaterOrEquals(5) is not even a valid expression on its own. (d) a nested deployment can be looped, but on its own it does not iterate; batchSize is a property of a copy element that controls serial versus parallel creation, not a substitute for it.",
 "spiegazione_it": "Corretta: a. L'elemento copy è il costrutto di iterazione dei template ARM: applicato a una risorsa, prende un name per il ciclo e un count, e Resource Manager crea quel numero di istanze. copyIndex() fornisce poi l'indice con cui costruire un nome univoco, per esempio concat(parameters('baseName'), copyIndex()). Perché le altre sono sbagliate: (b) dependsOn stabilisce solo l'ordine di distribuzione, non crea mai risorse. (c) condition decide se una singola risorsa venga distribuita o no: è un interruttore booleano, non un ciclo, e greaterOrEquals(5) non è nemmeno un'espressione valida da sola. (d) una distribuzione annidata può essere messa in ciclo, ma da sola non itera; batchSize è una proprietà dell'elemento copy che governa la creazione seriale o parallela, non un suo sostituto.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/templates/copy-resources",
 "tags": "arm template, copy, copyIndex, iterazione"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Modify an existing Azure Resource Manager template",
 "tipo": "multiple_choice",
 "difficolta": 2,
 "domanda": "You must modify an ARM template so that the environment parameter only accepts the values dev, test and prod, and defaults to dev when the deployment does not supply it. Which two properties should you add to the parameter definition?",
 "domanda_it": "Devi modificare un template ARM perché il parametro environment accetti soltanto i valori dev, test e prod, e usi dev come predefinito quando la distribuzione non lo fornisce. Quali due proprietà dovresti aggiungere alla definizione del parametro?",
 "opzione_a": "allowedValues and defaultValue",
 "opzione_a_it": "allowedValues e defaultValue",
 "opzione_b": "minValue and maxValue",
 "opzione_b_it": "minValue e maxValue",
 "opzione_c": "validation and initialValue",
 "opzione_c_it": "validation e initialValue",
 "opzione_d": "constraints and fallback",
 "opzione_d_it": "constraints e fallback",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. allowedValues takes an array of permitted values and makes the deployment fail validation if anything else is passed, and defaultValue supplies the value used when the parameter is omitted. Both are documented properties of a parameter object. Why the others are wrong: (b) minValue and maxValue are real ARM properties but apply only to int parameters, constraining a numeric range rather than a set of strings. (c) and (d) validation, initialValue, constraints and fallback are not ARM template properties at all - they are plausible-sounding names that do not exist in the schema, and a template containing them fails to deploy.",
 "spiegazione_it": "Corretta: a. allowedValues prende un array di valori consentiti e fa fallire la validazione della distribuzione se ne viene passato un altro, mentre defaultValue fornisce il valore usato quando il parametro viene omesso. Sono entrambe proprietà documentate di un oggetto parameter. Perché le altre sono sbagliate: (b) minValue e maxValue sono proprietà ARM reali, ma valgono solo per i parametri di tipo int e vincolano un intervallo numerico, non un insieme di stringhe. (c) e (d) validation, initialValue, constraints e fallback non sono affatto proprietà dei template ARM: sono nomi verosimili che non esistono nello schema, e un template che li contiene non si distribuisce.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/templates/parameters",
 "tags": "arm template, parameters, allowedValues, defaultValue"
},
{
 "batch_id": "CMP-K",
 "dominio": "Deploy and manage Azure compute resources",
 "sotto_argomento": "Manage sizing and scaling for containers, including Azure Container Instances and Azure Container Apps",
 "tipo": "multiple_choice",
 "difficolta": 3,
 "domanda": "A container app named app-worker in Azure Container Apps processes messages from an Azure Service Bus queue. The queue is empty for most of the night. You must ensure that app-worker costs nothing while the queue is empty, and scales out as messages arrive. What should you configure?",
 "domanda_it": "Un'app container denominata app-worker in Azure Container Apps elabora messaggi da una coda di Azure Service Bus. Per gran parte della notte la coda è vuota. Devi fare in modo che app-worker non costi nulla mentre la coda è vuota e che scali all'arrivo dei messaggi. Cosa dovresti configurare?",
 "opzione_a": "A custom scale rule based on Azure Service Bus, with the minimum replica count set to 0",
 "opzione_a_it": "Una scale rule personalizzata basata su Azure Service Bus, con numero minimo di repliche impostato a 0",
 "opzione_b": "An HTTP scale rule with the minimum replica count set to 0",
 "opzione_b_it": "Una scale rule HTTP con numero minimo di repliche impostato a 0",
 "opzione_c": "A custom scale rule based on Azure Service Bus, with the minimum replica count set to 1",
 "opzione_c_it": "Una scale rule personalizzata basata su Azure Service Bus, con numero minimo di repliche impostato a 1",
 "opzione_d": "An autoscale rule on the Container Apps environment that targets 70 percent CPU",
 "opzione_d_it": "Una regola di scalabilità automatica sull'ambiente Container Apps che punta al 70 percento di CPU",
 "risposta_corretta": "a",
 "spiegazione": "Correct: a. Container Apps scaling is driven by KEDA, which offers custom scale rules for event sources including Azure Service Bus. Setting the minimum replica count to 0 lets the app scale to zero, and in the Consumption plan you are not charged for resources while no replica is running. Why the others are wrong: (b) an HTTP scale rule reacts to concurrent HTTP requests, and this worker is triggered by queue messages, not by HTTP traffic - it would never scale out. (c) a minimum of 1 keeps a replica running all night, which meets the scaling requirement but not the cost requirement. (d) scale rules are defined per container app in its revision, not on the environment, and CPU utilization is not the signal that reflects queue depth.",
 "spiegazione_it": "Corretta: a. La scalabilità di Container Apps è guidata da KEDA, che offre scale rule personalizzate per sorgenti di eventi fra cui Azure Service Bus. Impostare il numero minimo di repliche a 0 consente all'app di scalare a zero, e nel piano Consumption non paghi risorse mentre nessuna replica è in esecuzione. Perché le altre sono sbagliate: (b) una scale rule HTTP reagisce alle richieste HTTP concorrenti, mentre questo worker è innescato dai messaggi in coda, non dal traffico HTTP: non scalerebbe mai. (c) un minimo di 1 tiene una replica accesa tutta la notte, il che soddisfa il requisito di scalabilità ma non quello di costo. (d) le scale rule si definiscono per singola container app nella sua revision, non sull'ambiente, e l'utilizzo di CPU non è il segnale che riflette la profondità della coda.",
 "url_riferimento": "https://learn.microsoft.com/en-us/azure/container-apps/scale-app",
 "tags": "container apps, keda, scale rule, scale to zero"
}
]
